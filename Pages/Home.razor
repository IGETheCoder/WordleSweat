@inject WordListService WordService
@page "/"

<PageTitle>Wordle Sweat</PageTitle>

<h1>Wordle Sweat</h1>
<p>Become a sweat at Wordle.</p>

<div class="letter-row">
    @for (int i = 0; i < 5; i++)
    {
        var index = i;

        <div class="letter-cell">
            <input class="letter-input @GetStateClass(letters[index].State)"
                   maxlength="1"
                   value="@letters[index].Value"
                   @oninput="(e) => OnLetterInput(index, e)" />

            <div class="color-row">
                <button class="color grey"
                        @onclick="() => SetState(index, 0)"></button>
                <button class="color yellow"
                        @onclick="() => SetState(index, 1)"></button>
                <button class="color green"
                        @onclick="() => SetState(index, 2)"></button>
            </div>
        </div>
    }
</div>

<br>

<button @onclick="Generate">
    Generate
</button>
<button @onclick="GenerateAll">
    Generate All
</button>
<button @onclick="Test">
    Test Me
</button>

@if (string.IsNullOrEmpty(_error))
{
    @if (_generatingSingle)
    {
        <p>Generating...</p>
    }
    else if (!string.IsNullOrEmpty(_singleResult))
    {
        <p>@_singleResult</p>
    }

    @if (_generatingMulti || _multiResult.Any(r => r.valid))
    {
        @if (_generatingMulti)
        {
            <p>Generating...</p>
        }
        var ordered = _multiResult.OrderByDescending(r => r.priority);
        @foreach (var result in ordered)
        {
            @if (result.valid)
            {
                <p>@result.word</p>
            }
        }
    }
}
else
{
    <div class="error">
        <p>@_error</p>
    </div>
}

@code {
    private LetterCell[] letters = new LetterCell[5];

    private string _error = "";
    private string _singleResult = "";
    private GenResult[] _multiResult = new GenResult[243]; //word , priority

    private bool _generatingSingle = false;
    private bool _generatingMulti = false;

    private bool _generatingAny = false;

    private async Task Generate ()
    {
        if (_generatingAny) return;
        _generatingAny = true;

        _error = "";
        _singleResult = "";
        ClearMultiResult(0);
        _generatingSingle = true;

        await InvokeAsync(StateHasChanged);
        (_singleResult, _error) = await GenerateBest.Gen(letters, WordService);

        _generatingSingle = false;
        _generatingAny = false;
    }
    private async Task GenerateAll ()
    {
        if (_generatingAny) return;
        _generatingAny = true;

        _error = "";
        _singleResult = "";
        ClearMultiResult((int) Math.Pow(3,5));
        _generatingMulti = true;

        await InvokeAsync(StateHasChanged);
        _multiResult[0] = new("word1", 1);
        _multiResult[1] = new("word2", 2);
        _multiResult[2] = new("word3", 3);

        _generatingMulti = false;
        _generatingAny = false;
    }
    private async Task Test ()
    {

    }

    private void ClearMultiResult(int length)
    {
        _multiResult = new GenResult[length];
        for (int i = 0; i < length; i++)
            _multiResult[i] = new();
    }

    protected override void OnInitialized ()
    {
        for (int i = 0; i < 5; i++)
            letters[i] = new();
        ClearMultiResult(0);
    }
    protected override async Task OnInitializedAsync ()
    {
        await WordService.LoadAsync();
    }

    private async void OnLetterInput (int index, ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";

        if (!string.IsNullOrWhiteSpace(value))
            value = value.Substring(0, 1).ToUpper();

        letters[index].Value = value;

        if (index < 4)
        {
            await Task.Delay(1);
            FocusNext(index + 1);
        }

        StateHasChanged();
    }
    private void FocusNext (int index)
    {
        // JS interop needed for perfect focus (we'll ignore for now)
    }

    private void SetState (int index, int state)
    {
        letters[index].State = state;
    }
    private string GetStateClass (int state)
    {
        return state switch
        {
            1 => "yellow",
            2 => "green",
            _ => "grey"
        };
    }
}
